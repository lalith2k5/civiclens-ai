# Database
DATABASE_URL=postgresql://$(whoami)@localhost:5432/civiclens

# App
APP_ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# Storage (local adapter for dev; S3-compatible in prod)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/uploads

# ML
IMAGE_CLASSIFIER_ENABLED=true
IMAGE_CLASSIFIER_MODEL_PATH=./ml/models/civic_classifier.pt
RESOLUTION_MODEL_PATH=./ml/models/resolution_rf.joblib
FORECAST_MODEL_PATH=./ml/models/forecast_sarima.pkl
ML_KILL_SWITCH=false
